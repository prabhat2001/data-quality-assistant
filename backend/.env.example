# Local Postgres for development. Replace USER with your OS username.
# To use Supabase later, paste the pooler URI and set SEED_DEMO_DATA=false:
# postgresql+psycopg2://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://USER@localhost:5432/data_quality
SEED_DEMO_DATA=true

# OpenAI writes the suggested checks and translates plain-language requests.
# Leave OPENAI_API_KEY blank to fall back to the built-in profiler.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional. Used only when LLM_PROVIDER=gemini.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Used only when LLM_PROVIDER=groq.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
