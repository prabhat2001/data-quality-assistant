# Local Postgres for development. Replace USER with your OS username.
# To use Supabase later, paste the pooler URI and set SEED_DEMO_DATA=false:
# postgresql+psycopg2://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://USER@localhost:5432/data_quality
SEED_DEMO_DATA=true

# Free development model. Create a key at https://aistudio.google.com/apikey
# Leave the key blank to use the built-in profiler until you have one.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Other free-tier option. Used only when LLM_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Paid switch later. Set LLM_PROVIDER=openai and paste the key. No code change.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
